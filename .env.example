# Copy to .env for local testing (Vercel dev), or set as an env var directly
# in the Vercel project dashboard for deployment. Never commit the real key.
ANTHROPIC_API_KEY=sk-ant-...your-key-here

# Resend (resend.com) sends lead-notification emails to businesses. Free
# tier exists. Without this set, lead capture logs server-side instead of
# emailing - safe, but not useful to a real client, so set before launch.
RESEND_API_KEY=re_...your-key-here
LEAD_FROM_ADDRESS=Frontdesk <leads@your-verified-domain.com>

# Optional - BCC yourself on every lead email as a safety net and to see
# real lead volume across clients, without building a database.
LEAD_BCC_ADDRESS=you@youremail.com

# Stripe (stripe.com) - powers the automated "start your 7-day free trial"
# self-serve signup (api/create-checkout.js, api/stripe-webhook.js,
# api/checkout-status.js). All three are required for that flow to work.
STRIPE_SECRET_KEY=sk_live_...or_sk_test_...for_testing
# The Price ID behind the existing £45/mo product (Stripe Dashboard -> that
# product -> copy the price_... id, don't create a new product).
STRIPE_PRICE_ID=price_...
# From Stripe Dashboard -> Developers -> Webhooks -> your endpoint's signing
# secret, after adding an endpoint at https://YOUR-DOMAIN/api/stripe-webhook
# subscribed to: checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted.
STRIPE_WEBHOOK_SECRET=whsec_...

# GitHub - lets the Stripe webhook publish a new client's config by
# committing configs/{key}.json directly to this repo, which triggers the
# existing Vercel auto-deploy. Use a FINE-GRAINED personal access token
# scoped to only this one repo, Contents: Read & Write, nothing else.
# Fine-grained tokens expire (max 1 year) - set a reminder to rotate it.
GITHUB_TOKEN=github_pat_...
GITHUB_OWNER=justanothervisionary
GITHUB_REPO=frontdesk-ai
GITHUB_BRANCH=main

# The real production URL, used to build Stripe success/cancel redirect
# URLs and to lock down CORS on the two payment endpoints above (instead of
# the "*" the older chat/lead endpoints use).
SITE_BASE_URL=https://frontdesk-ai-chi-ten.vercel.app
ALLOWED_ORIGIN=https://frontdesk-ai-chi-ten.vercel.app
