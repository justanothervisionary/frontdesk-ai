# Copy to .env for local testing (Vercel dev), or set as an env var directly
# in the Vercel project dashboard for deployment. Never commit the real key.
ANTHROPIC_API_KEY=sk-ant-...your-key-here

# Resend (resend.com) sends lead-notification emails to businesses. Free
# tier exists. Without this set, lead capture logs server-side instead of
# emailing - safe, but not useful to a real client, so set before launch.
RESEND_API_KEY=re_...your-key-here
LEAD_FROM_ADDRESS=Frontdesk <leads@your-verified-domain.com>

# Optional - BCC yourself on every lead email as a safety net and to see
# real lead volume across clients, without building a database.
LEAD_BCC_ADDRESS=you@youremail.com

# Stripe (stripe.com) - powers the automated "start your 7-day free trial"
# self-serve signup (api/create-checkout.js, api/stripe-webhook.js,
# api/checkout-status.js). All three are required for that flow to work.
STRIPE_SECRET_KEY=sk_live_...or_sk_test_...for_testing
# The Price ID behind the existing £45/mo product (Stripe Dashboard -> that
# product -> copy the price_... id, don't create a new product).
STRIPE_PRICE_ID=price_...
# From Stripe Dashboard -> Developers -> Webhooks -> your endpoint's signing
# secret, after adding an endpoint at https://YOUR-DOMAIN/api/stripe-webhook
# subscribed to: checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted.
STRIPE_WEBHOOK_SECRET=whsec_...

# GitHub - lets the Stripe webhook publish a new client's config by
# committing configs/{key}.json directly to this repo, which triggers the
# existing Vercel auto-deploy. Use a FINE-GRAINED personal access token
# scoped to only this one repo, Contents: Read & Write, nothing else.
# Fine-grained tokens expire (max 1 year) - set a reminder to rotate it.
GITHUB_TOKEN=github_pat_...
GITHUB_OWNER=justanothervisionary
GITHUB_REPO=frontdesk-ai
GITHUB_BRANCH=main

# The real production URL. Used to build Stripe success/cancel redirect
# URLs, to lock down CORS on the signup-flow endpoints (create-checkout -
# which also handles the early-email-capture action, checkout-status,
# upload-avatar, upload-draft-text - these only ever get called from our
# own site), and as one of the always-allowed origins for the widget-facing
# chat/lead endpoints (see api/_lib/cors.js - those also allow each
# business's own registered domain, since a client's widget calls them
# from their own website).
SITE_BASE_URL=https://frontdesk-ai-chi-ten.vercel.app
ALLOWED_ORIGIN=https://frontdesk-ai-chi-ten.vercel.app

# Authenticates api/weekly-digest.js, which Vercel Cron calls on the
# schedule in vercel.json's "crons" - Vercel automatically sends this as a
# Bearer token on cron-triggered requests once it's set here, so the
# endpoint can tell a real scheduled run apart from anyone else just
# hitting the URL (which would otherwise mass-email every client). Any long
# random string works - e.g. generate one with `openssl rand -hex 32`.
CRON_SECRET=...

# Signs the client dashboard's login tokens and session cookies
# (api/_lib/session.js - HMAC-SHA256, no JWT library). Any long random
# string works - e.g. generate one with `openssl rand -hex 32`. Rotating
# this instantly logs every business out and invalidates any in-flight
# login email links - harmless, just something to know before rotating it
# casually.
SESSION_SECRET=...

# The admin/ops dashboard (site/admin-dashboard.html) - a comma-separated
# allowlist of emails allowed to log into it via the same magic-link flow
# as the business dashboard, just on a separate cookie. Anyone not on this
# list is rejected on every request, not just at login, so removing an
# email here takes effect immediately.
ADMIN_EMAILS=you@youremail.com

# Upstash Redis, added via the Vercel Marketplace (Storage -> Create
# Database -> Upstash for Redis) - backs api/_lib/usage.js's per-business
# message/token counters shown on the admin dashboard. Free tier is
# generous at this project's scale. Without these set, usage tracking
# silently no-ops (chat still works normally, the admin dashboard just
# shows zeros) - same "not configured yet" handling already used for
# RESEND_API_KEY. Use the REST API credentials, not a redis:// connection
# string - this project talks to Upstash over HTTP (fetch), no Redis
# client library.
#
# These exact names come from setting the integration's "Custom Prefix" to
# UPSTASH_REDIS_REST when connecting it to this project - Vercel's Upstash
# integration then appends its own fixed _KV_REST_API_URL/_KV_REST_API_TOKEN
# suffixes on top of that prefix. If you set a different custom prefix (or
# none), the actual names in your Vercel dashboard will differ - check
# Settings -> Environment Variables for whatever really got created rather
# than assuming these exact names.
UPSTASH_REDIS_REST_KV_REST_API_URL=https://...upstash.io
UPSTASH_REDIS_REST_KV_REST_API_TOKEN=...

# WhatsApp Business Platform (Meta Cloud API) - powers api/whatsapp.js, the
# WhatsApp channel. Requires setting up a Meta Business Account/App and
# WhatsApp product yourself first (not something achievable from code) -
# see developers.facebook.com/docs/whatsapp/cloud-api/get-started. One
# access token (a System User token, not the default 24h-expiring one) can
# send on behalf of every phone number under your own Business Portfolio/
# WABA - only each business's own phone_number_id (set via the dashboard's
# admin-edit, stored as config.whatsapp.phoneNumberId) varies per client,
# not the token itself.
WHATSAPP_ACCESS_TOKEN=...
# From the same Meta App's Settings -> Basic -> App Secret - used to verify
# that an incoming webhook POST genuinely came from Meta (HMAC-SHA256 over
# the raw request body, checked against the X-Hub-Signature-256 header).
WHATSAPP_APP_SECRET=...
# Any long random string you invent yourself - e.g. `openssl rand -hex 32`.
# Entered in TWO places that must match exactly: here, and in Meta's App
# dashboard -> WhatsApp -> Configuration -> Webhook, when you set the
# webhook URL to https://YOUR-DOMAIN/api/whatsapp and click Verify.
WHATSAPP_VERIFY_TOKEN=...
# Optional - defaults to v21.0 if unset. Pin to whatever Graph API version
# your Meta App is actually using if you ever need a different one.
WHATSAPP_API_VERSION=v21.0

# Vercel Blob (Storage -> Create Database -> Blob, in the Vercel dashboard)
# - lets a visitor attach a photo/PDF to a conversation (api/lead.js's
# upload-attachment action), which gets linked in the lead notification
# email/dashboard. Auto-provisioned as this exact env var name when you
# create the store and connect it to this project - no manual value to
# invent. Without it set, the attach button in the widget still appears but
# fails gracefully (visitor is told to describe it in words instead) rather
# than erroring.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
